		{
			"name": "Dual Mode",
			"item": [
				{
					"name": "Run Dual (A vs B)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('runId', jsonData.id);",
									"    console.log('Run ID saved:', jsonData.id);",
									"    console.log('Run Status:', jsonData.status);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"suite_id\": \"{{suiteId}}\",\n  \"base_a\": \"https://api-old.example.com\",\n  \"base_b\": \"https://api-new.example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/runs/dual",
							"host": ["{{baseUrl}}"],
