				{
					"name": "Continue Single Run (After)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    console.log('Run Status:', jsonData.status);",
									"    if (jsonData.status === 'COMPLETED') {",
									"        console.log('✅ Run completed! Check diffs with GET /runs/' + jsonData.id + '/diffs');",
									"    }",
									"}"
								]
							}
						}
