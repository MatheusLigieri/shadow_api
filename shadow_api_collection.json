    {
      "name": "Runs",
      "description": "Execução de runs. Suporta dois modos:\n- **Dual**: executa todos os steps contra base_a e base_b simultaneamente e compara\n- **Single**: executa steps (BEFORE), aguarda o usuário chamar /continue, executa novamente (AFTER) e compara",
      "item": [
        {
          "name": "Dual Mode",
          "description": "Executa steps em dois endpoints diferentes (A vs B) e gera diffs.",
          "item": [
            {
              "name": "Start Dual Run",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const data = pm.response.json();",
                      "    pm.collectionVariables.set('runId', data.id);",
                      "    console.log('runId salvo:', data.id);",
                      "    console.log('Status:', data.status);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"suite_id\": \"{{suiteId}}\",\n  \"base_a\": \"https://api-old.example.com\",\n  \"base_b\": \"https://api-new.example.com\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/runs/dual",
                  "host": ["{{baseUrl}}"],
                  "path": ["runs", "dual"]
                },
                "description": "Inicia um run dual. Executa todos os steps contra base_a e base_b, gera diffs e retorna status=COMPLETED. O `runId` é salvo automaticamente."
              },
              "response": [
                {
                  "name": "201 Dual Run Completed",
                  "originalRequest": {
                    "method": "POST",
                    "header": [{ "key": "Content-Type", "value": "application/json" }],
                    "body": {
                      "mode": "raw",
