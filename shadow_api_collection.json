        {
          "name": "Single Mode",
          "description": "Executa steps em um único endpoint, salva snapshots BEFORE, aguarda o /continue e compara com snapshots AFTER.",
          "item": [
            {
              "name": "Start Single Run (Before)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const data = pm.response.json();",
                      "    pm.collectionVariables.set('runId', data.id);",
                      "    console.log('runId salvo:', data.id);",
                      "    console.log('Status:', data.status, '— chame Continue Single Run para prosseguir');",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"suite_id\": \"{{suiteId}}\",\n  \"base\": \"https://api.example.com\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/runs/single/start",
                  "host": ["{{baseUrl}}"],
                  "path": ["runs", "single", "start"]
                },
                "description": "Inicia a fase BEFORE do run single. Executa todos os steps e salva snapshots. Retorna status=WAITING_USER. O `runId` é salvo automaticamente."
              },
              "response": [
                {
                  "name": "201 Single Run Started (WAITING_USER)",
                  "originalRequest": {
                    "method": "POST",
                    "header": [{ "key": "Content-Type", "value": "application/json" }],
