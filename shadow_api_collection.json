{
  "info": {
    "_postman_id": "shadow-api-v2",
    "name": "Shadow API - Response Guard",
    "description": "Collection unificada da Shadow API.\n\nOrganizada em pastas por domínio:\n- **Infra** — liveness e readiness\n- **Suites** — gerenciamento de test suites\n- **Steps** — gerenciamento de steps dentro de suites\n- **Runs** — execução dual (A vs B) e single (before/after), status e diffs\n\nVariáveis de coleção:\n- `baseUrl` — base da API (padrão: http://localhost:8080)\n- `suiteId` — preenchido automaticamente ao criar suite\n- `stepId` — preenchido automaticamente ao criar step\n- `runId` — preenchido automaticamente ao iniciar run",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "suiteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "stepId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Infra",
      "description": "Endpoints de observabilidade: liveness e readiness da API.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifica se o serviço está no ar (liveness). Não depende do banco de dados."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/health",
                  "host": ["{{baseUrl}}"],
                  "path": ["health"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "cookie": [],
              "body": "{\n    \"status\": \"ok\"\n}"
            }
          ]
        },
